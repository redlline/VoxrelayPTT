# VoxRelay Environment Configuration

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (REQUIRED)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voxrelay
DB_USER=voxrelay
DB_PASSWORD=CHANGE_ME_REQUIRED

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cookie Secret (REQUIRED - must be at least 32 characters)
COOKIE_SECRET=CHANGE_ME_REQUIRED_MIN_32_CHARS

# JWT (REQUIRED - must be at least 32 characters)
JWT_ACCESS_SECRET=CHANGE_ME_REQUIRED_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REQUIRED_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Trusted proxy IPs (production - comma separated)
TRUSTED_PROXY_IPS=

# STUN/TURN
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:turn.example.com:3478
TURN_USER=example
TURN_CREDENTIAL=change_me

# CORS
CORS_ORIGIN=http://localhost:5173

# MinIO (REQUIRED for recordings)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_REQUIRED
MINIO_SECRET_KEY=CHANGE_ME_REQUIRED
MINIO_USE_SSL=false
MINIO_BUCKET=voxrelay-recordings

# Mediasoup
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_NUM_WORKERS=2

# Floor Control
FLOOR_TIMEOUT_MS=30000

# Metrics (optional - protects /metrics endpoint)
METRICS_TOKEN=

# NATS (v1.0+)
NATS_URL=nats://localhost:4222
