{
  "name": "voxrelay",
  "version": "0.1.0",
  "private": true,
  "description": "VoxRelay — Open source Push-to-Talk system for enterprise and dispatcher use",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "db:migrate": "pnpm --filter @voxrelay/api-gateway run db:migrate",
    "db:seed": "pnpm --filter @voxrelay/api-gateway run db:seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0",
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "ws": "^8.20.1"
  },
  "dependencies": {
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3"
  }
}
