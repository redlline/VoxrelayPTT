{
  "name": "@voxrelay/api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --out-dir dist --external package.json --no-splitting",
    "start": "node dist/main.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:load": "RUN_LOAD_TEST=1 vitest run test/load/ws-load.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/websocket": "^11.0.0",
    "bcrypt": "^5.1.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.0",
    "mediasoup": "^3.14.0",
    "mediasoup-client": "^3.7.0",
    "minio": "^8.0.0",
    "nanoid": "^5.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.20.1"
  }
}
